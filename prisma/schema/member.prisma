model Member {
    id_member   Int       @id @default(autoincrement())
    firstName   String
    lastName    String
    birthDate   DateTime
    email       String    @unique
    password    String
    avatar      String?
    createdAt   DateTime  @default(now())
    id_employee Int?
    admin       Employee? @relation(fields: [id_employee], references: [id_employee])

    meetings  Meeting[]
    documents Document[]
}
