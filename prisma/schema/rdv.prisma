/*
 Table pour les rdv 
*/
model RDV {
    rdv_id Int @id @unique @default(autoincrement())
    title String 
    content String
    type RDVType @default(INSCRIPTION)
    date DateTime
    duration DateTime

    state RDVState @default(PENDING)

    advisor_id Int
    advisor User @relation("rdv_advisor", fields: [advisor_id], references: [user_id])
    member_id Int
    member User @relation("rdv_member", fields: [member_id], references: [user_id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// Exemple de type de rdv
enum RDVType {
    INSCRIPTION 
    OTHER
}

// Status du rendez vous (si celui-ci est confirmer, annullé, rater ou passé)
enum RDVState {
    PENDING
    VALIDATED
    CANCELLED
    MISSED
    COMPLETED
}