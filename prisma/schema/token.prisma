model Token {
    id_token Int @id @default(autoincrement())
    tokenType TokenType
    token String @unique

    type_user UserType
    id_user Int

    expiresAt DateTime
    createdAt DateTime @default(now())
}

enum UserType {
    EMPLOYEE
    MEMBER
}

enum TokenType {
    REFRESH_TOKEN
    UNVERIFIED_MAIL_CHANGE
    MAIL_VALIDATE
}