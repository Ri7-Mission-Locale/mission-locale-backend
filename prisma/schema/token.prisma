/*
Tables pour stoquer les tokens
*/
model Token {
    token_id Int @id @unique @default(autoincrement())
    token String @unique
    agent String? // Verifier le "user agent" pour les conseillés / admins ?
    type TokenType

    user_id Int
    user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

    expiresAt DateTime
    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum TokenType {
    REFRESH_TOKEN
    MAIL_VALIDATION
}

