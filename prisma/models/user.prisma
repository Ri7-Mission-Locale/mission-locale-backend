/**
 * Table pour les utilisateurs
 */
model User {
    user_id String @id @unique @default(uuid())

    first_name String
    last_name  String
    email      String   @unique
    password   String
    phone      String   @db.Char(10)
    home_phone String?  @db.Char(10)
    birth_date DateTime

    role     Role         @default(USER)
    verified Boolean      @default(false)
    token    Token[]
    document Document[]
    queue    QueueEntry[]

    informations_id Int?          @unique
    informations    Informations? @relation(references: [informations_id], fields: [informations_id])

    rdv_advisor Appointment[] @relation("rdv_advisor") // RDV du conseillé
    rdv_member  Appointment[] @relation("rdv_member") // RDV de l'adhérent

    received_messages Message[] @relation("receiver") // Messages reçus
    sended_messages   Message[] @relation("sender") // Messages envoyés

    // Liste des adhérents pour le conseillé et le conseillé pour l'adhérant
    users_id String?
    user     User[]  @relation("advisor")
    advisor  User?   @relation("advisor", fields: [users_id], references: [user_id], onDelete: Cascade)

    news                News[] //Liste des actualités rédigé par un conseiller
    inscriptionFilePath String? @db.VarChar(255) // Chemin du fichier d'inscription

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum Role {
    USER
    ADVISOR
    ADMIN
}
