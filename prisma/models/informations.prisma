/**
 * Informations supplementaire pour les utilisateurs
 */
model Informations {
    informations_id Int @id @unique @default(autoincrement())

    gender           Gender?
    family_situation Situation?
    marital_name     String?
    childrens        Int?       @default(0)
    birth_city       String?

    home_number       Int?
    home_address      String?
    home_postal_code  Int?
    home_municipality String?

    nationnality     Nationnality?
    hosting          Hosting?
    driving_liscence DrivingLiscence?
    transport        Transport?
    social_coverage  SocialCoverage?
    ressources       Ressources?

    // TODO Diplome, emploies formations
    User User?
}

enum Ressources {
    NONE
    SALARIES
    ARE_POLE_EMPLOI
    RSA
    OTHER
}

enum SocialCoverage {
    NONE
    MUTUELLE
    RSA
    SOCIAL_SECURITY
    BENEFICIARIES
    RIGHT_HOLDERS
    CMU
}

enum Transport {
    NONE
    AUTO
    MOTO_OR_CYCLO
}

enum DrivingLiscence {
    NO
    WAINTING
    YES
}

enum Hosting {
    AUTO
    FAMILLY
    FOYER
    OTHER
    PROBLEMS
}

enum Nationnality {
    FR
    CEE
    HORS_CEE
    JAPD
    RECENSE
}

enum Gender {
    M
    MME
}

enum Situation {
    SINGLE
    MARRIED
}
