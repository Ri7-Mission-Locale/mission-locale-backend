/**
 * Table pour les dates et information complémentaire d'un ateliers
 */
model Event {
    event_id    Int          @id @unique @default(autoincrement())
    date        DateTime
    content     String
    size        Int
    workshop_id Int
    workshop    Workshop     @relation(fields: [workshop_id], references: [workshop_id])
    queue       QueueEntry[]
    duration  Int
}
