/**
 * Table pour stoquer les messages entre deux utilisateurs
 */
model Message {
  message_id Int    @id @unique @default(autoincrement())
  message    String

  sender_id   String
  sender      User   @relation("sender", fields: [sender_id], references: [user_id])
  receiver_id String
  receiver    User   @relation("receiver", fields: [receiver_id], references: [user_id])

  createdAt DateTime @default(now())
}
