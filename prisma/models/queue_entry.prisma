/**
 * Tables pour les inscriptions et file d'attente lié a un evenement
 */
model QueueEntry {
    queue_id Int        @id @unique @default(autoincrement())
    state    QueueState @default(PENDING)
    user_id  String
    user     User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
    event_id Int
    event    Event      @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
}

enum QueueState {
    REGISTERED // Inscrit
    CANCELLED // Annulé
    PENDING // EN attente
}
